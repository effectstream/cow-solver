{
  "name": "cow-solver",
  "private": true,
  "workspaces": [
    "packages/solver",
    "packages/solver-core",
    "packages/solver-frontend",
    "packages/tests",
    "kernel/packages/api-contracts",
    "kernel/packages/database",
    "kernel/packages/kernel-client",
    "kernel/packages/node",
    "kernel/packages/offer-guard",
    "kernel/packages/validator"
  ],
  "scripts": {
    "start:solver": "bun run start.solver.ts",
    "start:solver-frontend": "bun run start.solver-frontend.ts",
    "typecheck": "bun run typecheck:solver",
    "typecheck:solver": "bun run scripts/solver-typecheck.ts",
    "test:unit": "bun test ./packages/solver ./packages/solver-core ./packages/solver-frontend ./packages/tests/grand-e2e ./deploy/scripts/lib"
  },
  "dependencies": {
    "@effectstream/midnight-contracts": "0.300.3",
    "@effectstream/mip-zswap-offer": "0.4.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@zswap-da/kernel-client": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0"
  }
}
