# BuildKit per-Dockerfile ignore file for deploy/images/solver/Dockerfile. The
# build context is the repository root; BuildKit reads
# `<dockerfile-path>.dockerignore` in preference to a root .dockerignore.
node_modules
**/node_modules

# Git metadata, the submodule's included (kernel/.git is a file pointing into
# the parent's .git/modules).
.git
**/.git
.github

*-debug.log
.DS_Store

# The deployment's generated state must never enter an image layer.
deploy/.env
deploy/**/.env
kernel/deploy/.env
